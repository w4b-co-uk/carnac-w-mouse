<controls:MetroWindow
    x:Class="Carnac.UI.PreferencesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:carnac="clr-namespace:Carnac"
    xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:Carnac.UI"
    xmlns:utilities="clr-namespace:Carnac.Utilities"
    xmlns:w4bui="clr-namespace:Carnac.UI"
    Name="PreferencesViewWindow"
    utilities:DesignTimeHelper.Background="Black"
    d:DataContext="{d:DesignInstance w4bui:PreferencesViewModel}"
    Foreground="{DynamicResource BlackBrush}"
    Height="875"
    Icon="../icon.ico"
    MinHeight="875"
    MinWidth="610"
    SaveWindowPosition="True"
    ShowMaxRestoreButton="False"
    ShowMinButton="False"
    ShowTitleBar="False"
    Width="610"
    mc:Ignorable="d">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.TabControl.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Dark.Blue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate x:Key="ColourPickerTemplate">
                <StackPanel
                    d:DataContext="{d:DesignInstance ui:AvailableColor}"
                    Orientation="Horizontal"
                    VerticalAlignment="Stretch">
                    <TextBlock
                        Background="{Binding Brush}"
                        Height="20"
                        Margin="2"
                        VerticalAlignment="Stretch"
                        Width="20" />
                    <TextBlock
                        Margin="2"
                        Text="{Binding Name}"
                        VerticalAlignment="Stretch" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <TabControl>
        <TabItem Header="{Binding TabGeneral, Source={x:Static utilities:Loc.Instance}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="274*" />
                    <ColumnDefinition Width="73*" />
                    <ColumnDefinition Width="257*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    Grid.RowSpan="2"
                    Grid.ColumnSpan="3"
                    Margin="10,0,10,37"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <ui:PositionOnMonitorSelector />
                        <w4bui:ThreeColumnControl LabelText="{Binding TopOffset, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="{Binding SelectedScreen.Height}"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="20"
                                    Value="{Binding Settings.TopOffset}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.TopOffset}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding BottomOffset, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="{Binding SelectedScreen.Height}"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="20"
                                    Value="{Binding Settings.BottomOffset}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.BottomOffset}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding LeftOffset, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="{Binding SelectedScreen.Width}"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="20"
                                    Value="{Binding Settings.LeftOffset}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.LeftOffset}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding RightOffset, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="10"
                                    Maximum="{Binding SelectedScreen.Width}"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="20"
                                    Value="{Binding Settings.RightOffset}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.RightOffset}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding Language, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemsSource="{Binding AvailableLanguages}"
                                    DisplayMemberPath="Name"
                                    SelectedValue="{Binding SelectedLanguage}"
                                    SelectedValuePath="Code" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <Separator Height="10" Margin="0" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Margin="47,5,0,5"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ResetToDefaultsCommand}"
                        Content="{Binding ResetToDefaults, Source={x:Static utilities:Loc.Instance}}"
                        Margin="0,0,5,0"
                        Padding="10,2" />
                    <Button
                        Command="{Binding SaveCommand}"
                        Content="{Binding Save, Source={x:Static utilities:Loc.Instance}}"
                        Padding="10,2" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="{Binding TabKeyboard, Source={x:Static utilities:Loc.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    Grid.RowSpan="1"
                    Margin="10,0,10,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <w4bui:ThreeColumnControl LabelText="{Binding PopupTextWidth, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="50"
                                    Maximum="1000"
                                    Minimum="0"
                                    SmallChange="10"
                                    TickFrequency="10"
                                    Value="{Binding Settings.ItemMaxWidth}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ItemMaxWidth}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding PopupOpacity, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="0.1"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    TickFrequency="0.05"
                                    Value="{Binding Settings.ItemOpacity}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ItemOpacity}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding PopupFadeDelay, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="2"
                                    Maximum="50"
                                    Minimum="1"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    Value="{Binding Settings.ItemFadeDelay}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ItemFadeDelay}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding MaxMessages, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="5"
                                    Maximum="50"
                                    Minimum="0"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    Value="{Binding Settings.MaxMessages}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.MaxMessages}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding FontSize, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="2"
                                    Maximum="48"
                                    Minimum="8"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    Value="{Binding Settings.FontSize}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.FontSize}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding FontColour, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding FontColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding BackgroundColor, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding ItemBackgroundColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ShortcutsOnly, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox Content="{Binding ShortcutsOnlyDesc, Source={x:Static utilities:Loc.Instance}}" IsChecked="{Binding Settings.DetectShortcutsOnly}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding CustomKeymaps, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <StackPanel Orientation="Vertical">
                                    <DockPanel>
                                        <Button Content="{Binding Browse, Source={x:Static utilities:Loc.Instance}}" Command="{Binding BrowseKeymapsFolderCommand}" DockPanel.Dock="Right" Margin="5,0,0,0" Padding="10,2" />
                                        <TextBox Text="{Binding Settings.CustomKeymapsFolder}" />
                                    </DockPanel>
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding CustomKeymapsDesc, Source={x:Static utilities:Loc.Instance}}" />
                                </StackPanel>
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding OnlyModifiers, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox Content="{Binding OnlyModifiersDesc, Source={x:Static utilities:Loc.Instance}}" IsChecked="{Binding Settings.ShowOnlyModifiers}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ShowSpaceAsUnicode, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox Content="{Binding ShowSpaceAsUnicodeDesc, Source={x:Static utilities:Loc.Instance}}" IsChecked="{Binding Settings.ShowSpaceAsUnicode}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ShowApplicationIcon, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox Content="{Binding ShowApplicationIconDesc, Source={x:Static utilities:Loc.Instance}}" IsChecked="{Binding Settings.ShowApplicationIcon}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ProcessFilter, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <StackPanel Orientation="Vertical">
                                    <TextBox Text="{Binding Settings.ProcessFilterExpression}" />
                                    <TextBlock HorizontalAlignment="Left" Text="{Binding ProcessFilterDesc, Source={x:Static utilities:Loc.Instance}}" />
                                </StackPanel>
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Right"
                    Margin="5"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ResetToDefaultsCommand}"
                        Content="{Binding ResetToDefaults, Source={x:Static utilities:Loc.Instance}}"
                        Margin="0,0,5,0"
                        Padding="10,2" />
                    <Button
                        Command="{Binding SaveCommand}"
                        Content="{Binding Save, Source={x:Static utilities:Loc.Instance}}"
                        Padding="10,2" />
                </StackPanel>
            </Grid>

        </TabItem>
        <TabItem Header="{Binding TabMouse, Source={x:Static utilities:Loc.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    Grid.RowSpan="1"
                    Margin="10,0,10,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <w4bui:ThreeColumnControl LabelText="{Binding ShowMouseClicks, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox IsChecked="{Binding Settings.ShowMouseClicks}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ShowClicksAsKeys, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox IsChecked="{Binding Settings.ShowMouseClickKeys}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ShowScrollAsKeys, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <CheckBox IsChecked="{Binding Settings.ShowMouseScrollKeys}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding MouseKeySize, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="2"
                                    Maximum="300"
                                    Minimum="8"
                                    SmallChange="1"
                                    TickFrequency="1"
                                    Value="{Binding Settings.MouseKeySize}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.MouseKeySize}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding StartScale, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SmallChange="0.1"
                                    TickFrequency="1"
                                    Value="{Binding Settings.ClickStartScale}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickStartScale}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding StartBorder, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SmallChange="0.1"
                                    TickFrequency="0.1"
                                    Value="{Binding Settings.ClickStartBorder}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickStartBorder}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding StartOpacity, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="0.1"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    TickFrequency="0.05"
                                    Value="{Binding Settings.ClickStartOpacity}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickStartOpacity}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding StopScale, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SmallChange="0.1"
                                    TickFrequency="1"
                                    Value="{Binding Settings.ClickStopScale}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickStopScale}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding StopBorder, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="1"
                                    Maximum="10"
                                    Minimum="0"
                                    SmallChange="0.1"
                                    TickFrequency="0.1"
                                    Value="{Binding Settings.ClickStopBorder}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickStopBorder, StringFormat={}{0:F2}}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding StopOpacity, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="0.1"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    TickFrequency="0.05"
                                    Value="{Binding Settings.ClickStopOpacity}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickStopOpacity}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding CircleFadeDelay, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <Slider
                                    IsSnapToTickEnabled="True"
                                    LargeChange="1000"
                                    Maximum="5000"
                                    Minimum="100"
                                    SmallChange="100"
                                    TickFrequency="200"
                                    Value="{Binding Settings.ClickFadeDelay}" />
                            </w4bui:ThreeColumnControl.MainContent>
                            <w4bui:ThreeColumnControl.OptionalContent>
                                <TextBox Foreground="White" Text="{Binding Settings.ClickFadeDelay}" />
                            </w4bui:ThreeColumnControl.OptionalContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding LeftClickColor, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding LeftClickColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding RightClickColor, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding RightClickColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding ScrollClickColor, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding ScrollClickColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding XButton1ClickColor, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding XButton1ClickColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                        <w4bui:ThreeColumnControl LabelText="{Binding XButton2ClickColor, Source={x:Static utilities:Loc.Instance}}">
                            <w4bui:ThreeColumnControl.MainContent>
                                <ComboBox
                                    ItemTemplate="{StaticResource ColourPickerTemplate}"
                                    ItemsSource="{Binding AvailableColors}"
                                    SelectedItem="{Binding XButton2ClickColor}" />
                            </w4bui:ThreeColumnControl.MainContent>
                        </w4bui:ThreeColumnControl>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="0,5,5.333,5.333"
                    Orientation="Horizontal">
                    <Button
                        Command="{Binding ResetToDefaultsCommand}"
                        Content="{Binding ResetToDefaults, Source={x:Static utilities:Loc.Instance}}"
                        Margin="0,0,5,0"
                        Padding="10,2" />
                    <Button
                        Command="{Binding SaveCommand}"
                        Content="{Binding Save, Source={x:Static utilities:Loc.Instance}}"
                        Padding="10,2" />
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="{Binding TabAbout, Source={x:Static utilities:Loc.Instance}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer
                    Grid.RowSpan="1"
                    Margin="10,0,10,0"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Margin="20,40,0,0" Orientation="Horizontal">
                            <StackPanel Width="340">
                                <TextBlock
                                    FontFamily="Segoe UI Light"
                                    FontSize="18.667"
                                    Foreground="#FF41B1E1"
                                    HorizontalAlignment="Left"
                                    Margin="0,-7,0,0"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Bottom">
                                    <Run Text="{Binding AboutCode52, Source={x:Static utilities:Loc.Instance}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    FontFamily="Segoe UI Light"
                                    FontSize="20"
                                    Foreground="White"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    Text="{Binding AboutProjectBy, Source={x:Static utilities:Loc.Instance}}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Foreground="White"
                                    Margin="0,4,0,0"
                                    Text="{Binding Authors}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    FontFamily="Segoe UI Light"
                                    FontSize="20"
                                    Foreground="White"
                                    HorizontalAlignment="Left"
                                    Margin="0,10,0,0"
                                    TextWrapping="Wrap">
                                    <Run Text="{Binding AboutUses, Source={x:Static utilities:Loc.Instance}, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Foreground="White"
                                    Margin="0,4,0,0"
                                    Text="{Binding Components}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel>
                                <Image
                                    Height="200"
                                    HorizontalAlignment="Center"
                                    Source="/Carnac;component/carnac_2.png"
                                    Stretch="UniformToFill"
                                    VerticalAlignment="Top"
                                    Width="200" />
                                <TextBlock
                                    FontSize="50"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    HorizontalAlignment="Left"
                                    Margin="-4,0,0,0"
                                    TextWrapping="Wrap">
                                    <Run Text="Carnac" /><LineBreak /><Run Text="w/ Mouse" />
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Height="auto"
                    HorizontalAlignment="Right"
                    Margin="0,5,5.333,5.333"
                    Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock
                            FontWeight="Bold"
                            Foreground="White"
                            Height="20.83"
                            HorizontalAlignment="Right"
                            Margin="0,0,5,10"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center">
                            <Run Text="{Binding AboutVersion, Source={x:Static utilities:Loc.Instance}, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Version, Mode=OneTime}" />
                        </TextBlock>
                        <Button
                            Command="{Binding VisitCommand}"
                            Content="{Binding VisitWebsite, Source={x:Static utilities:Loc.Instance}}"
                            HorizontalAlignment="Center"
                            Margin="0,0,5,0"
                            Padding="10,2" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>
</controls:MetroWindow>
